# ============================================================================
# Configuration File - AutoVideoMaker + AI Metadata Generator
# ============================================================================
#
# SETUP:
# 1. Copia questo file in .env:
#    cp .env.example .env
#
# 2. Inserisci le tue chiavi API nel file .env
#
# 3. Esegui run.sh normalmente - caricherà automaticamente le configurazioni
#
# ============================================================================

# Deepgram API Key (trascrizione - METODO DI DEFAULT)
# Ottieni la tua chiave gratuita (200$ di credito) su: https://console.deepgram.com/signup
# Se non impostata, la trascrizione userà Whisper (locale) come fallback
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Anthropic API Key (metadati testuali con Claude Opus 5 - opzionale)
# Ottieni la tua chiave su: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key (thumbnail con GPT Images 2 - opzionale)
# Ottieni la tua chiave su: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# Note:
# - NON committare mai il file .env nel repository!
# - Il file .env è già incluso nel .gitignore
# - Usa solo caratteri alfanumerici e trattini nelle chiavi API
# - Lo script run.sh carica automaticamente queste variabili
# - Se ANTHROPIC_API_KEY non è impostata, il processing funziona comunque
#   ma salta la generazione dei metadati AI e della thumbnail
# - Se OPENAI_API_KEY non è impostata, viene saltata solo la thumbnail
# ============================================================================
